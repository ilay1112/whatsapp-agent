  class="m-0 text-sm text-text"
  data-kind="move"
  data-testid="change-line"
  lang="en"
>
  <span
    aria-hidden="true"
    data-testid="change-line-visible"
  >
    <span>
      Place: 
      <bdi>
        Cafe Noir
      </bdi>
       
    </span>
    <span
      aria-hidden="true"
      class="change-arrow"
      data-testid="change-arrow"
    >
      →
    </span>
    <span>
       
      <bdi>
        Office
      </bdi>
    </span>
  </span>
  <span
    class="sr-only"
    data-testid="change-line-sentence"
  >
    Place change from Cafe Noir to Office
  </span>
</p>
`;

