// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChangeLine - RTL snapshots > en cancel 1`] = `
<p
  class="m-0 text-sm text-text"
  data-kind="cancel"
  data-testid="change-line"
  lang="en"
>
  <span
    aria-hidden="true"
    data-testid="change-line-visible"
  >
    Cancel: 
    <bdi>
      Meeting
    </bdi>
    , 
    <bdi>
      Wed 15:00
    </bdi>
  </span>
  <span
    class="sr-only"
    data-testid="change-line-sentence"
  >
    Cancel Meeting, Wed 15:00
  </span>
</p>
`;

exports[`ChangeLine - RTL snapshots > en move 1`] = `
