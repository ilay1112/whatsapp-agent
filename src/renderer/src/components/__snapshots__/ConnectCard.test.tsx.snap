// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ConnectCard - RTL > RTL snapshot: not_installed (the command field stays LTR) 1`] = `
<section
  class="flex flex-col gap-2"
  data-selected="false"
  data-size="full"
  data-state="not_installed"
  data-testid="connect-claude_cli"
>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <span
      aria-hidden="true"
      class="icon icon-terminal text-warn"
    />
    <span
      class="grow"
      data-testid="connect-state-claude_cli"
      role="status"
    >
      Claude Code לא מותקן במחשב הזה.
    </span>
  </div>
  <p
    class="m-0 text-sm"
  >
    הריצו את הפקודה ב-PowerShell וחזרו לכאן:
  </p>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <input
      aria-label="פקודת התקנה / פקודת עדכון"
      class="field command-field min-w-0 grow basis-60"
      data-testid="connect-command-claude_cli"
      dir="ltr"
      readonly=""
      value="irm https://claude.ai/install.ps1 | iex"
    />
    <button
      class="btn btn-primary"
      data-testid="connect-copy-claude_cli"
      type="button"
    >
      העתקת הפקודה
    </button>
  </div>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <span
      class="grow text-sm text-text-muted"
    >
      האפליקציה אף פעם לא מתקינה דבר בעצמה.
    </span>
    <button
      class="btn btn-quiet"
      data-testid="connect-open-install-claude_cli"
      type="button"
    >
      פתיחת דף ההתקנה
    </button>
    <button
      class="btn btn-quiet"
      data-testid="connect-check-claude_cli"
      type="button"
    >
      בדיקה חוזרת
    </button>
  </div>
  <div
    class="flex flex-col items-start gap-1"
  >
    <button
      aria-describedby="ai-use-why-claude_cli"
      class="btn btn-outline"
      data-testid="ai-use-claude_cli"
      disabled=""
      type="button"
    >
      שימוש ב-Claude - המנוי שלך
    </button>
    <span
      class="text-xs text-text-muted"
      id="ai-use-why-claude_cli"
    >
      קודם צריך להשלים את השלבים שלמעלה
    </span>
  </div>
</section>
`;

