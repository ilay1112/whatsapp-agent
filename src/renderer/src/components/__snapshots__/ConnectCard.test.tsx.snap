exports[`ConnectCard - RTL > RTL snapshot: ready (the command field stays LTR) 1`] = `
<section
  class="flex flex-col gap-2"
  data-selected="false"
  data-size="full"
  data-state="ready"
  data-testid="connect-claude_cli"
>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <span
      class="grow"
      data-testid="connect-state-claude_cli"
      role="status"
    >
      מוכן - Claude Code 2.1.258, מחובר לחשבון.
    </span>
  </div>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <label
      class="font-semibold"
      for="connect-model-claude_cli"
    >
      מודל
    </label>
    <input
      aria-invalid="false"
      class="field w-52"
      data-testid="connect-model-claude_cli"
      dir="ltr"
      id="connect-model-claude_cli"
      list="connect-claude-presets"
      spellcheck="false"
      value="sonnet"
    />
    <datalist
      id="connect-claude-presets"
    >
      <option
        value="sonnet"
      >
        sonnet (מומלץ)
      </option>
      <option
        value="haiku"
      >
        haiku
      </option>
      <option
        value="opus"
      >
        opus
      </option>
    </datalist>
    <span
      class="text-sm text-text-muted"
    >
      לפי מה שזמין במנוי שלך
    </span>
  </div>
  <div
    class="flex flex-wrap items-center gap-2"
  >
    <button
      class="btn btn-outline"
      data-testid="connect-test-claude_cli"
      type="button"
    >
      הרצת בדיקה
    </button>
    <span
      class="text-sm text-text-muted"
    >
      (משתמש במעט מהמכסה שלך)
    </span>
  </div>
  <div
    class="flex flex-col items-start gap-1"
  >
    <button
      class="btn btn-outline"
      data-testid="ai-use-claude_cli"
      type="button"
    >
      שימוש ב-Claude - המנוי שלך
    </button>
  </div>
</section>
`;

